# Frontend image — build with Vite, serve with nginx.
# nginx also proxies /api/* to the backend service on the compose network.

# ---- Build stage ----------------------------------------------------------
FROM node:20-alpine AS build

WORKDIR /build
COPY package.json ./
RUN npm install
COPY . .
RUN npm run build

# ---- Runtime stage --------------------------------------------------------
FROM nginx:1.27-alpine

# nginx config that serves the SPA and proxies /api to the backend.
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Built assets from the Vite stage.
COPY --from=build /build/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
