# Backend image — FastAPI + AI Provider
#
# Runs the FastAPI backend with the configured LLM provider
# (Groq by default, but easily extensible to OpenAI, Gemini,
# Ollama, etc.). Uvicorn serves the API on port 8000.

FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PORT=8000

WORKDIR /app

# Install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application source
COPY . .

EXPOSE 8000

# Start FastAPI application
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]